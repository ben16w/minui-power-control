#!/bin/sh
BIN_DIR="$(dirname "$0")"

architecture=arm
if uname -m | grep -q '64'; then
    architecture=arm64
fi

export PATH="$BIN_DIR/$architecture:$BIN_DIR/$PLATFORM:$BIN_DIR:$PATH"

# overridable so the test suite can observe what the scripts write
TMP_DIR="${POWERCONTROL_TMP_DIR:-/tmp}"
SYS_DIR="${POWERCONTROL_SYS_DIR:-/sys}"

SYSTEM_SUSPEND_SCRIPT="$SYSTEM_PATH/bin/suspend"

# NextUI turns the h700 panel off itself before calling its suspend script,
# which leaves it to the caller, so the screen would otherwise stay lit
screen_off() {
    if [ "$PLATFORM" = "h700" ]; then
        set-brightness 0
        echo 1 > "$SYS_DIR/class/graphics/fb0/blank"
    fi
}

screen_on() {
    if [ "$PLATFORM" = "h700" ]; then
        echo 0 > "$SYS_DIR/class/graphics/fb0/blank"
        syncsettings.elf
    fi
}

suspend_system() {
    SCRIPT="$SYSTEM_SUSPEND_SCRIPT"
    PID="$1"

    echo "Suspending system..."

    if [ ! -f "$SCRIPT" ]; then
        echo "Suspend script not found. Is deep sleep supported on this device?"
        fallback_suspend "$PID"
        return
    fi
    chmod +x "$SCRIPT"

    if [ -n "$PID" ]; then
        echo "Suspending app process with PID: $PID"
        kill -STOP "$PID" || true
    fi

    screen_off
    "$SCRIPT"
    screen_on

    if [ -n "$PID" ]; then
        echo "Resuming app process with PID: $PID"
        kill -CONT "$PID" || true
    fi

    if [ "$PLATFORM" = "tg5040" ]; then
        set-brightness 2
        syncsettings.elf
    fi
}

fallback_suspend() {
    PID="$1"
    echo "Fallback suspend for app process with PID: $PID"

    if [ -z "$PID" ]; then
        echo "No PID provided for fallback suspend."
        return 1
    fi

    if [ ! -f "$TMP_DIR/powercontrol-suspend-active" ]; then
        echo "Pausing app process with PID: $PID"
        kill -STOP "$PID" || true
        [ "$PLATFORM" = "tg5040" ] && set-brightness 0
        touch "$TMP_DIR/powercontrol-suspend-active"
    else
        echo "Resuming app process with PID: $PID"
        kill -CONT "$PID" || true
        [ "$PLATFORM" = "tg5040" ] && syncsettings.elf
        rm -f "$TMP_DIR/powercontrol-suspend-active"
    fi
}

main() {
    if [ -f "$TMP_DIR/powercontrol-app-pid" ]; then
        PROCESS_PID=$(cat "$TMP_DIR/powercontrol-app-pid")
        echo "App PID file found. Suspending the app process with PID: $PROCESS_PID"

        if [ -z "$PROCESS_PID" ] || ! kill -0 "$PROCESS_PID" 2>/dev/null; then
            echo "App process $PROCESS_PID not found."
            exit 1
        fi

        suspend_system "$PROCESS_PID"
    elif [ -f "$TMP_DIR/powercontrol-dummy-pid" ]; then
        echo "Dummy PID file found. No app process to suspend."
        suspend_system
    else
        echo "App PID file not found."
        exit 1
    fi
}

main "$@"
