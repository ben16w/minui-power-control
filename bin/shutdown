#!/bin/sh
BIN_DIR="$(dirname "$0")"

architecture=arm
if uname -m | grep -q '64'; then
    architecture=arm64
fi

export PATH="$BIN_DIR/$architecture:$BIN_DIR/$PLATFORM:$BIN_DIR:$PATH"

# overridable so the test suite can observe what the scripts write
TMP_DIR="${POWERCONTROL_TMP_DIR:-/tmp}"
PROC_DIR="${POWERCONTROL_PROC_DIR:-/proc}"

show_message() {
    message="$1"
    seconds="$2"

    if [ -z "$seconds" ]; then
        seconds="forever"
    fi

    killall minui-presenter >/dev/null 2>&1 || true
    echo "$message" 1>&2
    if [ "$seconds" = "forever" ]; then
        minui-presenter --message "$message" --timeout -1 &
    else
        minui-presenter --message "$message" --timeout "$seconds"
    fi
}

shutdown_system() {
    echo "Shutting down system..."
    # NextUI only closes an open play session on its next start, so the session
    # is closed here, when play actually ends
    if command -v gametimectl.elf >/dev/null 2>&1; then
        gametimectl.elf stop_all
    fi
    show_message "Powering off" forever
    sync
    if [ "$IS_NEXT" = "yes" ]; then
        # NextUI's MinUI.pak/launch.sh polls /tmp/poweroff and calls poweroff_next
        # itself once the foreground process exits.
        touch "$TMP_DIR/poweroff"
        killall -TERM nextui.elf 2>/dev/null || true
        if [ -f "$TMP_DIR/next" ]; then
            ACTIVE_PAK=$(cat "$TMP_DIR/next" | tr -d "'\"")
            if [ -n "$ACTIVE_PAK" ]; then
                PAK_DIR=$(dirname "$ACTIVE_PAK")
                # BusyBox has no pkill; walk /proc and match cmdline ourselves.
                for proc in "$PROC_DIR"/[0-9]*/cmdline; do
                    cmdline=$(tr '\0' ' ' < "$proc" 2>/dev/null)
                    case "$cmdline" in
                        *"$PAK_DIR"*)
                            pid=${proc#"$PROC_DIR"/}; pid=${pid%/cmdline}
                            kill -TERM "$pid" 2>/dev/null || true
                            ;;
                    esac
                done
            fi
        fi
    else
        poweroff
    fi
    while :; do
        sleep 1
    done
}

main() {
    if [ -f "$TMP_DIR/powercontrol-app-pid" ]; then
        PROCESS_PID=$(cat "$TMP_DIR/powercontrol-app-pid")
        echo "App PID file found. Killing the app process with PID: $PROCESS_PID"

        if [ -z "$PROCESS_PID" ] || ! kill -0 "$PROCESS_PID" 2>/dev/null; then
            echo "App process $PROCESS_PID not found."
            exit 1
        fi

        # a paused app cannot act on the signal, and on NextUI the pak has to
        # exit before the device powers off
        if [ -f "$TMP_DIR/powercontrol-suspend-active" ]; then
            rm -f "$TMP_DIR/powercontrol-suspend-active"
            killall -CONT keymon.elf 2>/dev/null || true
            kill -CONT "$PROCESS_PID" || true
        fi

        kill "$PROCESS_PID" || true
    elif [ -f "$TMP_DIR/powercontrol-dummy-pid" ]; then
        echo "Dummy PID file found. No app process to kill."
    else
        echo "App PID file not found."
        exit 1
    fi

    shutdown_system
}

main "$@"
