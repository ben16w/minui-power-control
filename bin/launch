#!/bin/sh
BIN_DIR="$(dirname "$0")"

architecture=arm
if uname -m | grep -q '64'; then
    architecture=arm64
fi

export PATH="$BIN_DIR/$architecture:$BIN_DIR/$PLATFORM:$BIN_DIR:$PATH"

# overridable so the test suite can observe what the scripts write
TMP_DIR="${POWERCONTROL_TMP_DIR:-/tmp}"

print_usage() {
    echo "Usage: $0 [<app-binary> [<rom-path>]]"
    echo "If no app binary is specified, a dummy PID file will be created."
    echo "The rom path lets a device that powers off while asleep resume the rom when it next starts."
}

cleanup() {
    echo "Cleaning up minui-power-control..."
    if [ -n "$HANDLER_PROCESS_PID" ]; then
        echo "Cleaning up button-handler process with PID: $HANDLER_PROCESS_PID"
        kill "$HANDLER_PROCESS_PID" || true
        wait "$HANDLER_PROCESS_PID" || true
    fi
    rm -f "$TMP_DIR/powercontrol-app-pid"
    rm -f "$TMP_DIR/powercontrol-dummy-pid"
    rm -f "$TMP_DIR/powercontrol-rom-path"
}

main() {
    trap "cleanup" EXIT INT TERM HUP QUIT

    echo "Starting minui-power-control..."

    if [ "$PLATFORM" = "tg3040" ] && [ -z "$DEVICE" ]; then
        export DEVICE="brick"
        export PLATFORM="tg5040"
    fi

    if [ "$PLATFORM" = "miyoomini" ] && [ -z "$DEVICE" ]; then
        export DEVICE="miyoomini"
        if [ -f /customer/app/axp_test ]; then
            export DEVICE="miyoominiplus"
        fi
    fi

    if [ "$PLATFORM" = "tg5050" ] && [ -z "$DEVICE" ]; then
        export DEVICE="smartpros"
    fi

    if [ "$PLATFORM" = "my355" ] && [ -z "$DEVICE" ]; then
        export DEVICE="my355"
    fi

    # a whole word match, as grep also accepted every substring, so rg35xx and
    # tg50 both passed as supported platforms
    allowed_platforms="tg5040 tg5050 my355 rg35xxplus miyoomini h700"
    case " $allowed_platforms " in
        *" $PLATFORM "*) ;;
        *)
            echo "$PLATFORM is not a supported platform."
            exit 1
            ;;
    esac

    # Pak launchers normally export SYSTEM_PATH; default it for standalone runs.
    export SYSTEM_PATH="${SYSTEM_PATH:-/mnt/SDCARD/.system/$PLATFORM}"

    if ! command -v minui-presenter >/dev/null 2>&1; then
        echo "minui-presenter binary not found."
        exit 1
    fi

    if ! command -v button-handler >/dev/null 2>&1; then
        echo "button-handler binary not found."
        exit 1
    fi

    if [ ! -f "$BIN_DIR/shutdown" ]; then
        echo "shutdown script not found."
        exit 1
    fi

    if [ ! -f "$BIN_DIR/suspend" ]; then
        echo "suspend script not found."
        exit 1
    fi

    if [ "$PLATFORM" = "tg5040" ] || [ "$PLATFORM" = "h700" ]; then
        if ! command -v syncsettings.elf >/dev/null 2>&1; then
            echo "syncsettings.elf binary not found."
            exit 1
        fi
        if ! command -v set-brightness >/dev/null 2>&1; then
            echo "set-brightness binary not found."
            exit 1
        fi
        chmod +x "$BIN_DIR/$PLATFORM/set-brightness"
    fi

    chmod +x "$BIN_DIR/$PLATFORM/minui-presenter"
    chmod +x "$BIN_DIR/$architecture/button-handler"
    chmod +x "$BIN_DIR/shutdown"
    chmod +x "$BIN_DIR/suspend"

    # NextUI names the rom it launched the pak for, so a pak that passes none
    # can still resume. MinUI and NextUI both hand a resumed rom a save slot
    # meant for their own emulator, which minarch would otherwise load the next
    # time it starts a game.
    ROM_PATH="${2:-${HOOK_ROM_PATH:-}}"
    rm -f "$TMP_DIR/resume_slot.txt"
    if [ -n "$ROM_PATH" ]; then
        echo "Rom path: $ROM_PATH"
        echo "$ROM_PATH" > "$TMP_DIR/powercontrol-rom-path"
    fi

    if [ "$#" -eq 0 ]; then
        echo "App process not specified. Creating a dummy PID file."
        touch "$TMP_DIR/powercontrol-dummy-pid"
    elif [ "$#" -le 2 ]; then
        APP_BIN="$1"
        APP_PROCESS_PID=""

        for _ in $(seq 1 10); do
            echo "Waiting for $APP_BIN to start..."
            APP_PROCESS_PID=$(pgrep "$APP_BIN" | head -n 1)
            if [ -n "$APP_PROCESS_PID" ] && kill -0 "$APP_PROCESS_PID" 2>/dev/null; then
                break
            fi
            sleep 1
        done

        if [ -z "$APP_PROCESS_PID" ] || ! kill -0 "$APP_PROCESS_PID" 2>/dev/null; then
            echo "App process $APP_BIN not found."
            exit 1
        fi

        echo "$APP_PROCESS_PID" > "$TMP_DIR/powercontrol-app-pid"
        echo "App PID: $APP_PROCESS_PID"
    else
        print_usage
    fi

    echo "Starting button-handler..."
    button-handler &
    HANDLER_PROCESS_PID=$!

    if [ -n "$APP_PROCESS_PID" ]; then
        echo "Waiting for app process $APP_PROCESS_PID to finish..."
        while kill -0 "$APP_PROCESS_PID" 2>/dev/null; do
            sleep 1
        done
    else
        echo "Waiting for dummy PID file to be removed..."
        while [ -f "$TMP_DIR/powercontrol-dummy-pid" ]; do
            sleep 1
        done
    fi
}

main "$@"