#!/bin/sh
BIN_DIR="$(dirname "$0")"

architecture=arm
if uname -m | grep -q '64'; then
    architecture=arm64
fi

export PATH="$BIN_DIR/$architecture:$BIN_DIR/$PLATFORM:$BIN_DIR:$PATH"

# Only the app knows how to save, so the pak names the keys the app saves on,
# in the format emit-key takes, and gives it time to finish before it is paused
# or ended. A pak that names none is sent nothing.
main() {
    if [ -z "$POWERCONTROL_SAVE_KEYS" ]; then
        exit 0
    fi

    if ! command -v emit-key >/dev/null 2>&1; then
        echo "emit-key binary not found, cannot send the save keys."
        exit 1
    fi

    echo "Sending save keys: $POWERCONTROL_SAVE_KEYS"
    if ! emit-key -k "$POWERCONTROL_SAVE_KEYS"; then
        echo "emit-key could not send the save keys."
        exit 1
    fi

    save_delay="${POWERCONTROL_SAVE_DELAY:-2}"
    if [ "$save_delay" != "0" ]; then
        sleep "$save_delay"
    fi
}

main "$@"
